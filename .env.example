# Copy to .env (git-ignored). API keys are server-side only; never import them into client code.
CARTESIA_API_KEY=

ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Leave unset for unknown jurisdiction; legal teaching examples require an explicit matching region.
COACHING_JURISDICTION=

# Optional client-visible ID of an existing Cartesia pronunciation dictionary (not a secret/API key).
VITE_CARTESIA_PRONUNCIATION_DICT_ID=
